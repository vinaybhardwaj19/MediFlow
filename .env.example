# ─────────────────────────────────────────────────────────────────────────────
#  MediFlow Enterprise — Root Environment Variables & Secrets Schema
# ─────────────────────────────────────────────────────────────────────────────

# Domain & Reverse Proxy
DOMAIN=mediflow.example.com

# Database (MongoDB Credentials)
MONGO_INITDB_ROOT_USERNAME=mediflow_admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_strong_mongo_password_64hex

# PHI Data Encryption
ENCRYPTION_KEY=replace_with_32_byte_hex_string_for_aes_256_gcm

# JWT Secrets
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_secret_1
JWT_REFRESH_SECRET=replace_with_64_char_random_hex_secret_2

# Monitoring & Security
GF_SECURITY_ADMIN_PASSWORD=replace_with_strong_grafana_admin_password

# External Integrations
GCP_PROJECT_ID=mediflow-sentinel-2036
BIGQUERY_DATASET=health_analytics
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
