# ─────────────────────────────────────────────
#  MediFlow Server — Environment Configuration
# ─────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/mediflow_dev
# Production: mongodb+srv://<user>:<pass>@cluster.mongodb.net/mediflow

# JWT
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_secret
JWT_REFRESH_SECRET=replace_with_64_char_random_hex_secret_2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (AES-256 for PHI data at rest)
ENCRYPTION_KEY=replace_with_32_char_hex_key_here

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=MediFlow <noreply@mediflow.com>

# ML Microservice
ML_ENGINE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
