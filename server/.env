# ─────────────────────────────────────────────
#  MediFlow Server — Environment Configuration
# ─────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/mediflow_dev
# Production: mongodb+srv://<user>:<pass>@cluster.mongodb.net/mediflow

# JWT
JWT_ACCESS_SECRET=a3f8c2e1b4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1
JWT_REFRESH_SECRET=f1e0d9c8b7a6f5e4d3c2b1a0f9e8d7c6b5a4f3e2d1c0b9a8f7e6d5c4b3a2f1e0
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (AES-256 for PHI data at rest)
ENCRYPTION_KEY=2085743ff19279e9b2912219472d934fee23b2da610b4c97a8d5110caf817ba5

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=MediFlow <noreply@mediflow.com>

# ML Microservice
ML_ENGINE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
