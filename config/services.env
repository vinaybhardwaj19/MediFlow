# ─────────────────────────────────────────────────────────────────────────────
#  config/services.env — Centralized Service Discovery (Docker DNS)
# ─────────────────────────────────────────────────────────────────────────────
#  Replaces all hardcoded localhost URLs with Docker service names.
#  Each service in docker-compose.yml references this file via env_file.
# ─────────────────────────────────────────────────────────────────────────────

# Internal service URLs (Docker DNS resolves these automatically)
ML_ENGINE_URL=http://ml-engine:8000
IDENTITY_SERVICE_URL=http://identity-service:8001
TRIAGE_SERVICE_URL=http://triage-service:8002
PHARMACY_SERVICE_URL=http://pharmacy-service:8003
NODE_API_URL=http://node-server:5000
GATEWAY_URL=http://gateway:8080

# Kafka (internal Docker network)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BROKERS=kafka:29092
