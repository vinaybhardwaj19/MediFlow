{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MediFlow Environment Variables Schema",
  "description": "Defines all required environment variables for MediFlow Enterprise deployment",
  "type": "object",
  "required": [
    "NODE_ENV",
    "PORT",
    "MONGO_URI",
    "MONGO_INITDB_ROOT_USERNAME",
    "MONGO_INITDB_ROOT_PASSWORD",
    "ENCRYPTION_KEY",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET"
  ],
  "properties": {
    "NODE_ENV": {
      "type": "string",
      "enum": ["development", "staging", "production"],
      "description": "Application environment",
      "default": "development"
    },
    "PORT": {
      "type": "integer",
      "description": "Node.js server listen port",
      "default": 5000
    },
    "LOG_LEVEL": {
      "type": "string",
      "enum": ["debug", "info", "warn", "error"],
      "description": "Logging verbosity",
      "default": "info"
    },
    "MONGO_URI": {
      "type": "string",
      "pattern": "^mongodb(\\+srv)?://",
      "description": "MongoDB connection string with authentication"
    },
    "MONGO_INITDB_ROOT_USERNAME": {
      "type": "string",
      "minLength": 3,
      "description": "MongoDB root username for Docker init"
    },
    "MONGO_INITDB_ROOT_PASSWORD": {
      "type": "string",
      "minLength": 16,
      "description": "MongoDB root password — minimum 16 characters"
    },
    "ENCRYPTION_KEY": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$",
      "description": "AES-256-GCM encryption key — exactly 32 bytes (64 hex chars)"
    },
    "JWT_ACCESS_SECRET": {
      "type": "string",
      "minLength": 32,
      "description": "JWT access token signing secret"
    },
    "JWT_REFRESH_SECRET": {
      "type": "string",
      "minLength": 32,
      "description": "JWT refresh token signing secret"
    },
    "KAFKA_BOOTSTRAP_SERVERS": {
      "type": "string",
      "description": "Kafka broker addresses",
      "default": "kafka:9092"
    },
    "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Kafka replication factor (3 for production)",
      "default": 1
    },
    "GF_SECURITY_ADMIN_PASSWORD": {
      "type": "string",
      "minLength": 8,
      "description": "Grafana admin dashboard password"
    },
    "ML_ALLOWED_ORIGIN": {
      "type": "string",
      "format": "uri",
      "description": "CORS allowed origin for ML Engine",
      "default": "http://localhost:5000"
    },
    "GCP_PROJECT_ID": {
      "type": "string",
      "description": "Google Cloud project ID for BigQuery ML",
      "default": "mediflow-sentinel-2036"
    },
    "BIGQUERY_DATASET": {
      "type": "string",
      "description": "BigQuery dataset name",
      "default": "health_analytics"
    },
    "GATEWAY_PORT": {
      "type": "integer",
      "description": "Go API Gateway listen port",
      "default": 8080
    },
    "DOMAIN": {
      "type": "string",
      "description": "Production domain for Caddy TLS",
      "default": "mediflow.example.com"
    },
    "GOOGLE_MAPS_API_KEY": {
      "type": "string",
      "description": "Google Maps API key for pharmacy geolocation"
    }
  }
}
