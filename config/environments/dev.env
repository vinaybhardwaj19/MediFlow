# ─────────────────────────────────────────────────────────────────────────────
#  MediFlow Enterprise — Development Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Database
MONGO_URI=mongodb://mediflow_admin:mediflow_secure_pass_2026@mongodb:27017/mediflow?authSource=admin
MONGO_INITDB_ROOT_USERNAME=mediflow_admin
MONGO_INITDB_ROOT_PASSWORD=mediflow_secure_pass_2026

# PHI Encryption (32 bytes = 64 hex chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secrets (development only — NOT for production)
JWT_ACCESS_SECRET=dev_access_secret_64_chars_long_000000000000000000000000000000
JWT_REFRESH_SECRET=dev_refresh_secret_64_chars_long_00000000000000000000000000000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1

# Monitoring
GF_SECURITY_ADMIN_PASSWORD=dev_grafana_admin_2026

# ML Engine
ML_ALLOWED_ORIGIN=http://localhost:5000

# Google Cloud (optional for dev)
GCP_PROJECT_ID=mediflow-sentinel-2036
BIGQUERY_DATASET=health_analytics

# Gateway
GATEWAY_PORT=8080
LEGACY_NODE_URL=http://localhost:5000
