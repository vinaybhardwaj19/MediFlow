# ─────────────────────────────────────────────────────────────────────────────
#  MediFlow Enterprise — Staging Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=staging
PORT=5000
LOG_LEVEL=info

# Database
MONGO_URI=mongodb://mediflow_admin:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/mediflow_staging?authSource=admin
MONGO_INITDB_ROOT_USERNAME=mediflow_admin
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_STAGING_MONGO_PASSWORD

# PHI Encryption (32 bytes = 64 hex chars)
ENCRYPTION_KEY=REPLACE_WITH_STAGING_ENCRYPTION_KEY_64_HEX_CHARS

# JWT Secrets
JWT_ACCESS_SECRET=REPLACE_WITH_STAGING_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STAGING_JWT_REFRESH_SECRET

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=2

# Monitoring
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_STAGING_GRAFANA_PASSWORD

# ML Engine
ML_ALLOWED_ORIGIN=https://staging.mediflow.example.com

# Google Cloud
GCP_PROJECT_ID=mediflow-sentinel-2036
BIGQUERY_DATASET=health_analytics_staging

# Gateway
GATEWAY_PORT=8080
LEGACY_NODE_URL=http://node-server:5000
