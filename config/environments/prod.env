# ─────────────────────────────────────────────────────────────────────────────
#  MediFlow Enterprise — Production Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
#  ⚠️  ALL values marked REPLACE_* MUST be set before production deployment.
#  Use strong random values: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Database
MONGO_URI=mongodb://mediflow_admin:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/mediflow?authSource=admin
MONGO_INITDB_ROOT_USERNAME=mediflow_admin
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_PRODUCTION_MONGO_PASSWORD

# PHI Encryption (32 bytes = 64 hex chars — generate with: openssl rand -hex 32)
ENCRYPTION_KEY=REPLACE_WITH_PRODUCTION_ENCRYPTION_KEY_64_HEX_CHARS

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=REPLACE_WITH_PRODUCTION_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_PRODUCTION_JWT_REFRESH_SECRET

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=3
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=3
KAFKA_DEFAULT_REPLICATION_FACTOR=3

# Monitoring
GF_SECURITY_ADMIN_PASSWORD=REPLACE_WITH_PRODUCTION_GRAFANA_PASSWORD

# ML Engine
ML_ALLOWED_ORIGIN=https://mediflow.example.com

# Google Cloud
GCP_PROJECT_ID=mediflow-sentinel-2036
BIGQUERY_DATASET=health_analytics
GOOGLE_MAPS_API_KEY=REPLACE_WITH_PRODUCTION_MAPS_KEY

# Gateway
GATEWAY_PORT=8080
LEGACY_NODE_URL=http://node-server:5000

# Domain
DOMAIN=mediflow.example.com
