# MediFlow 2036 — Identity Service Environment Variables
# ============================================================================
# Copy to .env and fill in the values for your environment.
# In Kubernetes production, these are injected via Secrets/ConfigMaps.
# ============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mediflow:mediflow@localhost:5432/mediflow_2036

# ── PQC Private Keys ──────────────────────────────────────────────────────────
# PLATFORM_DILITHIUM_SECRET_KEY:
#   The Dilithium-3 secret key used to SIGN Verifiable Credentials.
#   Generate with: python -c "from pqc_keys import DilithiumSigner, encode_b64url; kp=DilithiumSigner.generate_keypair(); print(encode_b64url(kp.secret_key))"
#   PRODUCTION: Store in HashiCorp Vault or AWS KMS, not in .env
PLATFORM_DILITHIUM_SECRET_KEY=

# GATEWAY_KYBER_SECRET_KEY:
#   The Kyber-768 secret key used to DECAPSULATE encrypted request bodies.
#   Generate with: python -c "from pqc_keys import KyberKEM, encode_b64url; kp=KyberKEM.generate_keypair(); print(encode_b64url(kp.secret_key))"
GATEWAY_KYBER_SECRET_KEY=

# ── Service Configuration ──────────────────────────────────────────────────────
# If left empty, the service runs in SIMULATION mode (exhibition-safe)
CORS_ALLOWED_ORIGIN=http://localhost:3000
LOG_LEVEL=info
